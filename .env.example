# ── Timezone ──────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ── Exposed ports (host) ──────────────────────────────────
DASHBOARD_PORT=3000
API_PORT=8081
WEBSOCKET_PORT=8082
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
INFLUXDB_PORT=8086

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ── InfluxDB ──────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=changeme-influxdb-token
INFLUXDB_ORG=iot
INFLUXDB_BUCKET=health_metrics
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=changeme-influxdb-password

# ── Dashboard ─────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=wss://your-domain.example.com/ws
# Leave empty when running behind nginx (same domain); set to http://localhost:8081 for local dev
NEXT_PUBLIC_API_URL=

# ── AI ────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
